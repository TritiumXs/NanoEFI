
#
# Platform Backend
#
# CONFIG_NANOEFI_BACKEND_LINUX is not set
CONFIG_NANOEFI_BACKEND_WIN32=y
# CONFIG_NANOEFI_BACKEND_BAREMETAL is not set
# CONFIG_NANOEFI_BACKEND_FREERTOS is not set
# end of Platform Backend

#
# Build Options
#
# CONFIG_NANOEFI_BUILD_DEBUG is not set
CONFIG_NANOEFI_BUILD_RELWITHDEBINFO=y
# CONFIG_NANOEFI_BUILD_RELEASE is not set
# CONFIG_NANOEFI_BUILD_MINSIZEREL is not set
# end of Build Options
